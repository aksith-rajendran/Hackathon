# Environment Configuration for AI Idea Stress Tester
# Copy this file to .env and adjust variables as needed

# Server Port (default: 5000)
PORT=5000

# Optional AI API Key (Gemini, OpenAI, or compatible provider)
# If left blank or as placeholder, backend runs high-fidelity local critic engines
AI_API_KEY=your_api_key_here

# AI Model to use (optional, e.g. gemini-1.5-flash, gpt-4o-mini)
AI_MODEL=gemini-1.5-flash

# Frontend URL for CORS (default: http://localhost:5173 for Vite dev server)
FRONTEND_URL=http://localhost:5173
